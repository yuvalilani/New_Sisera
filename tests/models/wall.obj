# Simple 3D Wall Model (width=10.0, thickness=0.4, height=3.0)
o Wall
usemtl Concrete
v -5.000000 -0.200000 0.000000
v  5.000000 -0.200000 0.000000
v  5.000000  0.200000 0.000000
v -5.000000  0.200000 0.000000
v -5.000000 -0.200000 3.000000
v  5.000000 -0.200000 3.000000
v  5.000000  0.200000 3.000000
v -5.000000  0.200000 3.000000
s off
# Bottom (z = 0, normal = (0, 0, -1))
f 1 4 3
f 1 3 2
# Top (z = 3, normal = (0, 0, 1))
f 5 6 7
f 5 7 8
# Front (y = -0.2, normal = (0, -1, 0))
f 1 2 6
f 1 6 5
# Back (y = 0.2, normal = (0, 1, 0))
f 3 4 8
f 3 8 7
# Left (x = -5, normal = (-1, 0, 0))
f 4 1 5
f 4 5 8
# Right (x = 5, normal = (1, 0, 0))
f 2 3 7
f 2 7 6
